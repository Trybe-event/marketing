# Public product-app origin. Configure after the web application is deployed.
# Local development defaults to http://localhost:3000 when this is empty.
# Production with no configured app keeps the existing entry preview.
NEXT_PUBLIC_WEB_APP_URL=

# Optional canonical marketing origin for social previews. Defaults to the current deployment.
NEXT_PUBLIC_SITE_URL=https://trybe-zeta.vercel.app
